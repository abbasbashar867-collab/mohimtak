# انسخ الملف إلى .env.local واملأ القيم. لا ترفع .env.local إلى GitHub.

# من Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# سري للغاية: خادم فقط. لا تضف إليه البادئة NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# عنوان الموقع كما يظهر في المتصفح (للحماية من الطلبات المزورة)
APP_URL=http://localhost:3000

# ترويسة عنوان IP التي تضبطها الاستضافة (Vercel: x-forwarded-for ، Netlify: x-nf-client-connection-ip)
TRUSTED_IP_HEADER=x-forwarded-for

# قيمة عشوائية طويلة لحماية مهمة حذف المستندات: openssl rand -hex 32
CRON_SECRET=

# رمز لمرة واحدة لفتح صفحة /setup وإنشاء المدير العام (24 رمزاً عشوائياً على الأقل). احذفه بعدها.
SETUP_TOKEN=
